font=JetBrainsMono Nerd Font 10

# Ubah #121118CC untuk transparansi ~80%, atau #12111899 untuk ~60%
background-color=#121118CC
text-color=#c3c3c5
border-color=#5C8EB4
progress-color=over #5b5b70

width=320
height=110
outer-margin=20
margin=6
padding=10

border-size=2
border-radius=10

icons=1
max-icon-size=32
markup=1
actions=1
history=1
format=<b>%s</b>\n%b
text-alignment=left

default-timeout=5000
max-visible=5
layer=overlay
anchor=top-right

sort=+time
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
on-touch=invoke-default-action
