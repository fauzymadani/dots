* {
    font-family: "JetBrainsMono Nerd Font Mono", "Inter", sans-serif;
    font-size: 14px;
    color: #E0E0E0; 
}

/* Main window background */
window {
    background-color: rgba(0, 0, 0, 0.75); 
    border-radius: 12px;
    padding: 16px;
    border: 1px solid rgba(120, 120, 120, 0.25); /
}

/* Search input field */
#input {
    margin: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 14px;
    color: #EEEEEE;
    background-color: rgba(20, 20, 20, 0.6); /
    border: 1px solid rgba(130, 130, 130, 0.25);
    box-shadow: none;
    outline: none;
    caret-color: #FFFFFF;
}

#input:focus {
    border: 1px solid rgba(160, 160, 160, 0.35);
    background-color: rgba(30, 30, 30, 0.75);
    box-shadow: none;
    outline: none;
}

/* Entry row */
#entry {
    padding: 6px 10px;
    border-radius: 6px;
    background-color: transparent;
    color: #D6D6D6;
}

/* Selected entry */
#entry:selected {
    background-color: rgba(255, 255, 255, 0.08); /
    color: #FFFFFF;
}

#entry image:first-child {
    min-width: 0;
    min-height: 0;
    margin: 6px;
    padding: 5px;
}

